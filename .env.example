# Copie este arquivo para .env e ajuste.
# Endereço do FreeLLMAPI.
# App do Windows/Mac: porta 31415 (veja "Running on" no ícone ao lado do relógio).
# Instalação por Docker ou pelos scripts deste repositório: porta 3001.
FREELLMAPI_URL=http://127.0.0.1:31415/v1
# Chave unificada: no FreeLLMAPI, página Chaves > "Copiar chave de API".
# Na nuvem, o scripts/iniciar.sh preenche sozinho.
FREELLMAPI_KEY=
# Modelo: "auto" deixa o roteador escolher o melhor disponível.
AGENCIA_MODELO=auto
# Porta do Estúdio AgenciaIa.
PORT=8080
