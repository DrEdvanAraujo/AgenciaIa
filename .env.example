# Copie este arquivo para .env e ajuste.
# Endereço do FreeLLMAPI (o app do seu PC usa a porta 3001).
FREELLMAPI_URL=http://localhost:3001/v1
# Chave unificada: no FreeLLMAPI, página Chaves > "Copiar chave de API".
# Na nuvem, o scripts/iniciar.sh preenche sozinho.
FREELLMAPI_KEY=
# Modelo: "auto" deixa o roteador escolher o melhor disponível.
AGENCIA_MODELO=auto
# Porta do Estúdio AgenciaIa.
PORT=8080
